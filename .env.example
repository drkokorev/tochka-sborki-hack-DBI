# Пример настроек. Скопируйте в .env и заполните. Без ключей ассистент работает на фразнике и правилах,
# с демо-данными вместо стенда МИС. На ВМ хакатона ключи берутся из /opt/hackathon/ai.env (см. run.sh).

# --- LLM: любой OpenAI-совместимый шлюз (GigaChat, vLLM, Ollama, OpenRouter) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=GigaChat/GigaChat-3-Pro
# 1 — передавать response_format=json_object (выключить, если модель его не поддерживает)
LLM_JSON_MODE=1
LLM_TIMEOUT=30
# 1 — перефразировать детерминированные ответы через LLM (по умолчанию выключено)
LLM_NLG=0
# Вместо LLM_* можно задать OPENAI_BASE_URL и OPENAI_API_KEY

# --- Стенд МИС «Регистратура» (DBI). Без токена — локальные демо-данные ---
DBI_API_URL=
DBI_API_TOKEN=
# Демо без стенда: реестр в SQLite (записи переживают перезапуск); пусто — только в памяти
DEMO_DB=data/demo.db
# Папка с расписанием кейса (doctors.csv, free_slots.csv, unavailable.csv) — tools/import_schedule.py
TIMETABLE_DIR=data

# --- Понимание речи ---
# 1 — модель-ученик (дистиллированный rubert-tiny2) в каскаде фразник → ученик → LLM
STUDENT=1
STUDENT_DIR=data/student
# Модель риска неявки (tools/train_noshow.py)
NOSHOW_MODEL=data/noshow_model.json

# --- Голос ---
# Распознавание — только GigaAM на машине: звук пациента не покидает её, облачного резерва нет (152-ФЗ).
# GigaAM недоступна — веб предлагает текст, телефон сразу переводит на регистратора
GIGAAM_MODEL=v3_e2e_ctc
# auto — Silero v5, если скачан (tools/get_voice.sh); piper — Piper
TTS_ENGINE=auto
# 1 — нейросетевой детектор речи Silero VAD в телефонии (пакет silero-vad); 0 — только порог громкости
SILERO_VAD=1
TTS_SPEAKER=xenia
SILERO_MODEL=voices/silero_v5_3_ru.pt
TTS_VOICE=voices/ru_RU-irina-medium.onnx

# --- Телефония (Asterisk на ВМ, deploy/setup_asterisk.sh) ---
TELEPHONY=0
AUDIOSOCKET_PORT=9092
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=assistant
# Секрет AMI генерирует deploy/setup_asterisk.sh и сам дописывает в .env
AMI_SECRET=
# Куда звонить с напоминанием в демо (софтфон команды); в эксплуатации номер пациента — из CRM клиники
PHONE_ENDPOINT=PJSIP/phone-094@gateway
# 1 — вечерний обзвон записей на завтра без ручного запуска (по убыванию риска неявки)
REMINDER_AUTO=0
REMINDER_AT=18:00

# --- Журнал разговоров (152-ФЗ: файл 0600, срок хранения) ---
JOURNAL_PATH=data/journal.json
JOURNAL_DAYS=30

# --- Рабочее место регистратора (152-ФЗ) ---
# Токен для журнала разговоров, карточек переводов, записей и обзвона (заголовок X-Desk-Token; интерфейс спросит
# его один раз). Пусто — открытый демо-режим с вымышленными данными; в эксплуатации обязателен
DESK_TOKEN=

# --- Инструменты проверки ---
# Адрес работающего ассистента для make call (tools/live_call.py)
ASSISTANT_URL=http://localhost:8000
# Модель Whisper на шлюзе — только для сравнения точности в tools/stt_bench.py (ассистент его не использует)
STT_MODEL=openai/whisper-large-v3
